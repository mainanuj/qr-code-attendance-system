PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qr_attendance
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
# Keep false/empty for local MySQL. Set true on Render for TiDB Cloud.
DB_SSL=false
# Optional: PEM certificate authority, with newline characters written as \n.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Leave true for TiDB Cloud unless its documentation explicitly says otherwise.
DB_SSL_REJECT_UNAUTHORIZED=true
# Comma-separated allowed frontend origins. Example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
